# systemd unit for running Popcorn without Docker on a Linux box.
# 1. Copy this file to /etc/systemd/system/popcorn.service
# 2. Adjust User= and WorkingDirectory= to match where you put the project
# 3. sudo systemctl daemon-reload && sudo systemctl enable --now popcorn
[Unit]
Description=Popcorn IPTV viewer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=swimmy
WorkingDirectory=/home/swimmy/popcorn/server
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
