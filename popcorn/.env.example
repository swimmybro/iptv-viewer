# Your Xtream Codes provider. Include the scheme and port if there is one.
XTREAM_HOST=http://provider.example.com:8080
XTREAM_USER=your-username
XTREAM_PASS=your-password

# Port Popcorn listens on. Open http://<optiplex-ip>:8080 from any device on your network.
PORT=8080

# Only show live categories whose name starts with one of these (comma-separated).
# Leave empty to show every category your provider has.
LIVE_CATEGORY_PREFIXES=

# How long (seconds) to cache channel/movie/series lists in memory.
CACHE_TTL=900

# ffmpeg is used to convert MKV/AVI files browsers can't play. Leave as "ffmpeg" if it is on
# your PATH, give a full path, or set it to an empty value to disable conversion.
FFMPEG_PATH=ffmpeg

# If your ISP blocks the provider domain, resolve it with a public DNS server instead:
# UPSTREAM_DNS=1.1.1.1
